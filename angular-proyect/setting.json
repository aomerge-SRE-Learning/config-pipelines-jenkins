{
  "project": "angular-proyect",
  "environments": {
    "development": {
      "namespace": "dev-labs-cluster",
      "credentials": {
        "tokenRef": "k8s_token_ci",
        "serverRef": "k8s_server_ci",
        "caRef": "k8s_ca_data_ci"
      },
      "docker": {
        "registry": "docker.io/aomerge-dev",
        "credentialId": "DockerHub"
      }
    },
    "qa": {
      "namespace": "qa-labs-cluster",
      "credentials": {
        "tokenRef": "k8s_token_qa",
        "serverRef": "k8s_server_qa",
        "caRef": "k8s_ca_data_qa"
      },
      "docker": {
        "registry": "docker.io/aomerge-qa",
        "credentialId": "DockerHub"
      }
    },
    "production": {
      "namespace": "prod-labs-cluster",
      "credentials": {
        "tokenRef": "k8s_token_prod",
        "serverRef": "k8s_server_prod",
        "caRef": "k8s_ca_data_prod"
      },
      "docker": {
        "registry": "us-central1-docker.pkg.dev/my-prod-project/my-repo",
        "credentialId": "artifact-registry-sa",
        "type": "artifact-registry"
      }
    }
  }
}
